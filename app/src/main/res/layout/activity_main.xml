<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNomeJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Jogador 1: " />

        <TextView
            android:id="@+id/tvPlacarJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="00"
            android:inputType="number"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bt1Jog1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+1"/>

        <Button
            android:id="@+id/bt3Jog1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+3"/>

        <Button
            android:id="@+id/bt6Jog1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+6"/>

        <Button
            android:id="@+id/bt9Jog1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+9"/>

        <Button
            android:id="@+id/bt12Jog1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+12"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNomeJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="Jogador 2: " />

        <TextView
            android:id="@+id/tvPlacarJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="00"
            android:inputType="number"/>

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/bt1Jog2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+1"/>

        <Button
            android:id="@+id/bt3Jog2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+3"/>

        <Button
            android:id="@+id/bt6Jog2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+6"/>

        <Button
            android:id="@+id/bt9Jog2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+9"/>

        <Button
            android:id="@+id/bt12Jog2"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="+12"/>

    </LinearLayout>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Histórico de Jogadas" />

    <Button
        android:id="@+id/btZerarHistorico"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Zerar Histórico" />

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:onClick="btAlterarNomeOnClick"
        android:text="Alterar Nomes" />

</LinearLayout>